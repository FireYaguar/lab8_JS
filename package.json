{
  "name": "spacefight",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w client",
    "start": "npm start -w server",
    "typecheck": "tsc -p shared && tsc -p shared/test && tsc -p server && tsc -p client && tsc -p client/tsconfig.node.json && tsc -p e2e",
    "test": "npm test -w shared && npm test -w server && npm test -w client",
    "lint": "biome check .",
    "format": "biome check --write .",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
